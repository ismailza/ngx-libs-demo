{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Auth": {
    "Provider": "Local",
    "Local": {
      "Jwt": {
        "Issuer": "ngx-libs-demo",
        "Audience": "ngx-libs-demo",
        "SigningKey": "",
        "AccessTokenMinutes": 5
      },
      "RefreshToken": {
        "Days": 7,
        "ReuseGraceSeconds": 10,
        "CookieName": "refresh_token",
        "CookiePath": "/api/auth",
        "Secure": true
      }
    },
    "Keycloak": {
      "Url": "",
      "Realm": "demo",
      "ClientId": "demo-web",
      "Audience": "demo-api",
      "RequireHttpsMetadata": true
    }
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "Enabled": false
  }
}

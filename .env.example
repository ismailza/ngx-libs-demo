# Copy to .env, then: docker compose up --build

# Local | Keycloak — see docs/auth-providers.md
AUTH_PROVIDER=Local
# Required with AUTH_PROVIDER=Keycloak: starts Keycloak and its database. Without it the
# API logs "Keycloak is not reachable" at startup and rejects every token.
#   AUTH_PROVIDER=Keycloak
#   COMPOSE_PROFILES=keycloak

# HMAC key for the Local provider's access tokens. At least 32 characters:
#   openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-long-random-string-of-at-least-32-chars

POSTGRES_PASSWORD=demo

# Short lifetimes make the background refresh easy to watch.
ACCESS_TOKEN_MINUTES=5

# Creates the demo accounts alice and admin. For local use only: anyone who can
# reach the app could sign in as admin. Set to false on any shared host.
SEED_DEMO_USERS=true
SEED_PASSWORD=Passw0rd!

# The stack serves plain HTTP. Set to true when it runs behind HTTPS.
REFRESH_COOKIE_SECURE=false

# Keycloak (only with COMPOSE_PROFILES=keycloak). The admin console at
# http://localhost:8180 uses KEYCLOAK_ADMIN; demo users live in the "demo" realm.

# Keycloak as the browser reaches it. Sets both the token issuer (KC_HOSTNAME) and the
# issuer the API expects (Auth__Keycloak__Url), so the two can't drift apart.
KEYCLOAK_URL=http://localhost:8180
# The app as the browser reaches it: the realm's allowed redirect URI. Read only when
# the realm is first imported (see docs/auth-providers.md to re-import).
APP_URL=http://localhost:8080
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcadmin
